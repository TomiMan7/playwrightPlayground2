{
  "name": "playwrightplayground2",
  "version": "1.0.0",
  "description": "Repo for practicing playwright",
  "main": "index.js",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test --config=config/playwright.config.ts",
    "test:ui": "npx playwright test --config=config/playwright.config.ts tests/practice2/ui.spec.ts --headed",
    "test:setup:ui": "npx playwright test --config=config/playwright.config.ts tests/setup/auth.setup.spec.ts",
    "prepare": "husky",
    "allure:generate": "npx allure generate allure-results --clean -o allure-report",
    "allure:open": "npx allure open allure-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TomiMan7/playwrightPlayground2.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/TomiMan7/playwrightPlayground2/issues"
  },
  "homepage": "https://github.com/TomiMan7/playwrightPlayground2#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.0.1",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "dotenv": "^17.4.2",
    "eslint": "^10.5.0",
    "globals": "^17.7.0",
    "http-status-codes": "^2.3.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.3",
    "typescript-eslint": "^8.62.0"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  }
}
